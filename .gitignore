# ─── Dependencies ───
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bower_components/

# Keep lockfile (npm) — needed for reproducible installs
# package-lock.json is intentionally NOT ignored

# ─── Build outputs (Vite / React) ───
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Logs ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / cache ───
pids/
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
*.tmp
*.temp

# ─── Env / secrets — never commit ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key

# ─── OS files ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Editors / IDEs ───
# VS Code
.vscode/*
!.vscode/extensions.json
# JetBrains
.idea/
*.iml
# Sublime / Vim / Emacs
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.bak
*.orig
# General editor backup
*.back
*.backup

# ─── Acode (mobile) + other mobile editors — hide all traces ───
.acode/
.acode/*
*.acode
.acode-project
foxdebug/
.foxdebug/
*Acode*
# Termux / Android file-manager leftovers
.termux/
*.termux
# Common mobile-editor / FTP sync leftovers
.ftpconfig
sftp-config.json
.ftpsync
# Phone camera / screenshot dumps accidentally added to repo root
1000*.png
*Photoroom*
*photoroom*
Screenshot_*.png
Screenshot_*.jpg
IMG_*.jpg
IMG_*.png
VID_*.mp4

# ─── AI / agent tooling — never push ───
.opencode/
.opencode/*
.openai/
.claude/
.cursor/
.cursorrules
.agent/
.ai/
codex/
.opencode-node/
*.agent.json

# ─── Python (used by some tooling scripts) ───
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage

# ─── Tests / coverage ───
coverage/
*.lcov
.nyc_output/

# ─── Misc ───
*.tgz
*.zip
