# Never put real credentials in source control. Use Secret Manager in Cloud Run.
# These defaults perform no paid calls and admit no requests.
SHERLOCK_ENABLED=false
SHERLOCK_PAID_CALLS_ENABLED=false
SHERLOCK_RATES_VERIFIED=false
SHERLOCK_MODEL=gemini-2.5-flash
SHERLOCK_SEARCH_PROVIDER=google
GOOGLE_CLOUD_PROJECT=your-project-id
# Verify current Vertex text input and output INCLUDING thinking rates.
# Use conservative paid rates even if the provider has free credits.
SHERLOCK_INPUT_USD_PER_MILLION=
SHERLOCK_OUTPUT_USD_PER_MILLION=
# Google Search grounding for Gemini 2.5: reserve paid per-prompt rate
# even when a free allowance may apply. Reverify current rates before enablement.
SHERLOCK_SEARCH_USD_PER_CALL=0.035
# Only required if SHERLOCK_SEARCH_PROVIDER=brave.
SHERLOCK_BRAVE_API_KEY=
# Worker/admin only. API uses its existing Cloud SQL Connector settings.
DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
DB_PORT=5432
DB_NAME=weaware
DB_USER=weaware_user
# DB_PASS is optional when db-password is available via Secret Manager.
